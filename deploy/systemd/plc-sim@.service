# Template unit: one instance per chamber.
#
#   sudo systemctl enable --now plc-sim@chamber-01
#   sudo systemctl enable --now plc-sim@chamber-02
#
# %i expands to whatever follows the @, so one file serves every chamber.
# This is the bare-metal path for an edge box with no container runtime;
# compose remains the default for development.

[Unit]
Description=Drying chamber PLC simulator (%i)
Documentation=file:/opt/plc-sim/docs/architecture.md
After=network-online.target
Wants=network-online.target

# Give up after 5 restarts in 5 minutes. A crash loop that never stops looks
# alive to monitoring while never doing any work, which is worse than a clean
# failure that someone gets paged for. These belong in [Unit], not [Service].
StartLimitIntervalSec=300
StartLimitBurst=5
# Wants, not Requires: the simulator binds 0.0.0.0 and is still useful when the
# uplink is down. Requires would drag it offline along with the network.

[Service]
Type=simple
User=plcsim
Group=plcsim
WorkingDirectory=/opt/plc-sim

# The leading dash makes the file optional: a chamber with no overrides is fine.
EnvironmentFile=-/etc/plc-sim/default.env
EnvironmentFile=-/etc/plc-sim/%i.env
Environment=CHAMBER_ID=%i
Environment=PYTHONUNBUFFERED=1

ExecStart=/opt/plc-sim/.venv/bin/python -m plc_sim.main

Restart=always
RestartSec=5
# Back off rather than hammering: 5s, then longer, capped at two minutes.
RestartSteps=4
RestartMaxDelaySec=120s


# A runaway simulator must not take the edge box down with it.
MemoryMax=256M
CPUQuota=50%

# Hardening: the process needs a TCP socket and its own read-only code.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
